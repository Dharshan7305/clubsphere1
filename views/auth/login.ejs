<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<main class="container">
  <div class="form-card">
    <div style="text-align: center; margin-bottom: 2rem;">
      <span class="brand-icon" style="width: 48px; height: 48px; font-size: 1.4rem; margin-bottom: 0.5rem;">CS</span>
      <h2 style="font-size: 1.75rem; color: var(--primary); font-weight: 800;">Sign in to ClubSphere</h2>
      <p style="color: var(--text-muted); font-size: 0.9rem; margin-top: 0.25rem;">
        College of Technology Club Discovery & Recruitment Platform
      </p>
    </div>

    <form action="/auth/login" method="POST">
      <div class="form-group">
        <label for="loginEmail">Email Address</label>
        <input 
          type="email" 
          id="loginEmail" 
          name="email" 
          class="form-control" 
          placeholder="yourname@college.ac.in" 
          required 
          autocomplete="email"
        >
      </div>

      <div class="form-group">
        <label for="loginPassword">Password</label>
        <input 
          type="password" 
          id="loginPassword" 
          name="password" 
          class="form-control" 
          placeholder="••••••••" 
          required 
          autocomplete="current-password"
        >
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 0.5rem;">
        Sign In to Portal &rarr;
      </button>
    </form>

    <div class="demo-access">
      <button
        type="button"
        class="demo-access-toggle"
        id="demoAccessToggle"
        aria-expanded="false"
        aria-controls="demoLoginPanel"
      >Demo sign-in</button>
      <div id="demoLoginPanel" class="demo-login-panel" hidden>
      <div style="font-size: 0.8rem; font-weight: 700; color: var(--primary); margin-bottom: 0.5rem; display: flex; align-items: center; gap: 4px;">
        <span>Choose a role to fill demo credentials:</span>
      </div>
      <div style="display: flex; gap: 6px; flex-wrap: wrap;">
        <button type="button" class="btn btn-sm btn-outline" onclick="fillLogin('student@college.ac.in', 'password123')">Student</button>
        <button type="button" class="btn btn-sm btn-outline" onclick="fillLogin('secretary@college.ac.in', 'password123')">Secretary</button>
        <button type="button" class="btn btn-sm btn-outline" onclick="fillLogin('core@college.ac.in', 'password123')">Core</button>
        <button type="button" class="btn btn-sm btn-outline" onclick="fillLogin('faculty@college.ac.in', 'password123')">Faculty</button>
        <button type="button" class="btn btn-sm btn-outline" onclick="fillLogin('admin@college.ac.in', 'password123')">Admin</button>
      </div>
    </div>
    </div>

    <div style="text-align: center; margin-top: 1.5rem; font-size: 0.88rem; color: var(--text-muted);">
      Don't have a student account? <a href="/auth/register" style="font-weight: 600;">Register as Student</a>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
