<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<main class="container">
  <div class="form-card">
    <div style="text-align: center; margin-bottom: 2rem;">
      <span class="brand-icon" style="width: 48px; height: 48px; font-size: 1.4rem; margin-bottom: 0.5rem;">CS</span>
      <h2 style="font-size: 1.75rem; color: var(--primary); font-weight: 800;">Sign in to ClubSphere</h2>
      <p style="color: var(--text-muted); font-size: 0.9rem; margin-top: 0.25rem;">
        ClubSphere | Your Campus. Your Community.
      </p>
    </div>

    <form action="/auth/login" method="POST">
      <div class="form-group">
        <label for="loginEmail">Email Address</label>
        <input 
          type="email" 
          id="loginEmail" 
          name="email" 
          class="form-control" 
          placeholder="Enter your college email"
          pattern="([0-9]{2}[a-zA-Z]{2}[0-9]{3}@psgtech\.ac\.in|[a-zA-Z0-9._%+-]+@college\.ac\.in)"
          title="Please enter your official college email (format: YYdeptNNN@psgtech.ac.in)"
          required 
          autocomplete="email"
        >
        <small style="color: var(--text-muted); font-size: 0.8rem; margin-top: 0.35rem; display: block;">
          Format: <strong>YYdeptNNN@psgtech.ac.in</strong> (Year + Department + Roll No)
        </small>
      </div>

      <div class="form-group">
        <label for="loginPassword">Password</label>
        <input 
          type="password" 
          id="loginPassword" 
          name="password" 
          class="form-control" 
          placeholder="Enter your password"
          required 
          autocomplete="current-password"
        >
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 0.5rem;">
        Sign In to Portal &rarr;
      </button>
    </form>

    <div style="text-align: center; margin-top: 1.5rem; font-size: 0.88rem; color: var(--text-muted);">
      Don't have a student account? <a href="/auth/register" style="font-weight: 600;">Register as Student</a>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
