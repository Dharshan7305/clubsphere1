<nav class="navbar">
  <div class="container nav-container">
    <a href="/" class="brand" title="ClubSphere – Your Campus. Your Community.">
      <span class="brand-icon">CS</span>
      <span class="brand-text">ClubSphere</span>
    </a>

    <div class="nav-right-actions">
      <ul class="nav-links">
        <li><a href="/" class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'home' ? 'active' : '' %>">Home</a></li>
        <li><a href="/clubs" class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'clubs' ? 'active' : '' %>">Discover Clubs</a></li>
        <li><a href="/events" class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'events' ? 'active' : '' %>">Campus Events</a></li>

        <% if (user) { %>
          <% if (user.role === 'student') { %>
            <li><a href="/student/dashboard" class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'dashboard' ? 'active' : '' %>">Dashboard</a></li>
            <li><a href="/student/applications" class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'applications' ? 'active' : '' %>">My Applications</a></li>
          <% } else if (user.role === 'secretary') { %>
            <li><a href="/secretary/dashboard" class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'dashboard' ? 'active' : '' %>">Secretary Panel</a></li>
            <li><a href="/secretary/applications" class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'applications' ? 'active' : '' %>">Applicants</a></li>
            <li><a href="/secretary/recruitments" class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'recruitments' ? 'active' : '' %>">Recruitments</a></li>
            <li><a href="/secretary/events" class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'events' ? 'active' : '' %>">Events</a></li>
          <% } else if (user.role === 'core') { %>
            <li><a href="/core/dashboard" class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'dashboard' ? 'active' : '' %>">Core Team Portal</a></li>
            <li><a href="/core/applications" class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'applications' ? 'active' : '' %>">Screening</a></li>
          <% } else if (user.role === 'faculty') { %>
            <li><a href="/faculty/dashboard" class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'dashboard' ? 'active' : '' %>">Faculty Portal</a></li>
            <li><a href="/faculty/recruitments" class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'recruitments' ? 'active' : '' %>">Approve Drives</a></li>
            <li><a href="/faculty/events" class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'events' ? 'active' : '' %>">Event Proposals</a></li>
          <% } else if (user.role === 'principal') { %>
            <li><a href="/principal/dashboard" class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'principal' ? 'active' : '' %>">Principal Portal</a></li>
            <li><a href="/principal/events" class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'events' ? 'active' : '' %>">Event Approvals</a></li>
          <% } else if (user.role === 'admin') { %>
            <li><a href="/admin/dashboard" class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'dashboard' ? 'active' : '' %>">Admin Center</a></li>
            <li><a href="/admin/clubs" class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'clubs' ? 'active' : '' %>">Clubs</a></li>
            <li><a href="/admin/users" class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'users' ? 'active' : '' %>">Users</a></li>
            <li><a href="/admin/reports" class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'reports' ? 'active' : '' %>">Reports</a></li>
          <% } %>

          <!-- Role-Based Notification Bell with Dropdown -->
          <li class="nav-notif-li">
            <div class="notif-dropdown-wrapper" id="notifDropdownWrapper">
              <button 
                id="notifBellBtn" 
                class="notif-bell-btn <%= (typeof unreadNotifs !== 'undefined' && unreadNotifs > 0) ? 'has-unread' : '' %>" 
                aria-label="Notifications" 
                aria-expanded="false" 
                title="Notifications (<%= typeof unreadNotifs !== 'undefined' ? unreadNotifs : 0 %> unread)"
              >
                <span class="bell-icon-svg" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                  </svg>
                </span>
                <% if (typeof unreadNotifs !== 'undefined' && unreadNotifs > 0) { %>
                  <span class="notif-badge-count" id="notifBadgeCount"><%= unreadNotifs > 99 ? '99+' : unreadNotifs %></span>
                <% } else { %>
                  <span class="notif-badge-count" id="notifBadgeCount" style="display: none;">0</span>
                <% } %>
              </button>

              <!-- Floating Dropdown Panel -->
              <div class="notif-dropdown-panel" id="notifDropdownPanel" role="region" aria-label="Notifications Panel">
                <div class="notif-dropdown-header">
                  <div class="notif-dropdown-title-wrap">
                    <span class="notif-title">Notifications</span>
                    <span class="notif-unread-pill" id="notifUnreadPill">
                      <%= (typeof unreadNotifs !== 'undefined' && unreadNotifs > 0) ? unreadNotifs + ' Unread' : 'All Read' %>
                    </span>
                  </div>
                  <button type="button" class="notif-mark-all-link" id="btnMarkAllRead" title="Mark all as read">
                    ✓ Mark all read
                  </button>
                </div>

                <div class="notif-dropdown-list" id="notifDropdownList">
                  <% if (typeof recentNotifications !== 'undefined' && recentNotifications.length > 0) { %>
                    <% recentNotifications.forEach(function(item) { %>
                      <div class="notif-item <%= item.isRead ? 'read' : 'unread' %>" data-id="<%= item._id %>">
                        <span class="notif-item-icon"><%= item.icon || '🔔' %></span>
                        <div class="notif-item-body">
                          <a href="<%= item.relatedLink || '#' %>" class="notif-item-link" data-id="<%= item._id %>">
                            <div class="notif-item-title"><%= item.title %></div>
                            <div class="notif-item-msg"><%= item.message %></div>
                            <div class="notif-item-time"><%= item.timeAgo %></div>
                          </a>
                        </div>
                        <% if (!item.isRead) { %>
                          <button type="button" class="notif-item-mark-btn" title="Mark as read" data-id="<%= item._id %>">✓</button>
                        <% } %>
                      </div>
                    <% }); %>
                  <% } else { %>
                    <div class="notif-empty-dropdown">
                      <span class="notif-empty-icon">📭</span>
                      <p>You're all caught up! No notifications.</p>
                    </div>
                  <% } %>
                </div>

                <div class="notif-dropdown-footer">
                  <a href="/notifications" class="notif-view-all-link">
                    <span>View All Notifications</span>
                    <span class="view-all-arrow">&rarr;</span>
                  </a>
                </div>
              </div>
            </div>
          </li>

          <li class="user-badge">
            <span class="user-avatar-dot"></span>
            <span><%= user.name.split(' ')[0] %></span>
            <span class="user-role-tag role-<%= user.role %>"><%= user.role %></span>
          </li>
          <li><a href="/auth/logout" class="btn btn-sm btn-outline-nav">Logout</a></li>
        <% } else { %>
          <li><a href="/auth/login" class="nav-link <%= typeof currentPage !== 'undefined' && currentPage === 'login' ? 'active' : '' %>">Login</a></li>
          <li><a href="/auth/register" class="btn-register-purple">Student Register</a></li>
        <% } %>
      </ul>

      <button id="themeToggle" class="theme-toggle-btn" aria-label="Toggle Theme" title="Toggle Light/Dark Theme">
        <span class="theme-icon">🌙</span>
      </button>

      <button class="mobile-menu-btn" aria-label="Toggle navigation">☰</button>
    </div>
  </div>
</nav>

<script src="/js/notifications.js" defer></script>
