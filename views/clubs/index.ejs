<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<main class="clubs-discovery-page">
  <!-- ========================================================
       PAGE HEADER & SEARCH SECTION
       ======================================================== -->
  <header class="clubs-hero-header">
    <div class="container text-center">
      <div class="clubs-count-pill">
        <span class="count-pill-dot"></span>
        <span>Explore <%= totalClubsCount || 30 %> Student Clubs</span>
      </div>

      <h1 class="clubs-main-heading">Discover Clubs</h1>
      <p class="clubs-subheading">
        Explore communities, discover your interests and find your place on campus.
      </p>

      <!-- Prominent Search Bar -->
      <div class="clubs-search-wrapper">
        <div class="clubs-search-box">
          <span class="clubs-search-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </span>
          <input 
            type="text" 
            id="clubSearchInput" 
            class="clubs-search-input" 
            placeholder="Search clubs by name or interest..." 
            value="<%= searchQuery || '' %>"
            autocomplete="off"
            aria-label="Search clubs"
          >
          <button type="button" id="clearSearchBtn" class="clubs-search-clear" title="Clear search" style="<%= searchQuery ? '' : 'display: none;' %>">
            ✕
          </button>
        </div>
      </div>

      <!-- Category Filter Carousel & Track -->
      <div class="clubs-filter-carousel-wrapper" id="filterCarouselWrapper">
        <button type="button" class="filter-scroll-btn filter-scroll-prev" id="filterScrollPrev" aria-label="Scroll filters left">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <div class="clubs-category-filters-track" id="clubsFilterTrack" role="tablist" aria-label="Club categories">
          <!-- All Clubs Button -->
          <button
            type="button"
            class="category-filter-btn <%= (selectedCategory === 'All Clubs' || selectedCategory === 'All') ? 'active' : '' %>"
            data-category="All Clubs"
            role="tab"
            aria-selected="<%= (selectedCategory === 'All Clubs' || selectedCategory === 'All') ? 'true' : 'false' %>"
          >
            <span class="filter-btn-icon" aria-hidden="true">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7"></rect>
                <rect x="14" y="3" width="7" height="7"></rect>
                <rect x="14" y="14" width="7" height="7"></rect>
                <rect x="3" y="14" width="7" height="7"></rect>
              </svg>
            </span>
            <span>All Clubs</span>
          </button>

          <!-- Recruitment Filter Toggle (Prominent with Live Pulsing Dot) -->
          <button
            type="button"
            id="recruitingFilterBtn"
            class="category-filter-btn filter-btn-recruiting"
            aria-pressed="false"
          >
            <span class="recruitment-live-dot" aria-hidden="true"></span>
            <span class="filter-btn-icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
              </svg>
            </span>
            <span>Open for Recruitment</span>
          </button>

          <!-- Recruiting Soon Filter Toggle -->
          <button
            type="button"
            id="recruitingSoonFilterBtn"
            class="category-filter-btn filter-btn-recruiting-soon"
            aria-pressed="false"
          >
            <span class="recruiting-soon-dot" aria-hidden="true"></span>
            <span class="filter-btn-icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </span>
            <span>Recruiting Soon</span>
          </button>

          <span class="filter-track-divider" aria-hidden="true"></span>

          <!-- Categories with Domain Icons -->
          <% categories.filter(c => c !== 'All Clubs' && c !== 'All').forEach(cat => { %>
            <button
              type="button"
              class="category-filter-btn <%= selectedCategory === cat ? 'active' : '' %>"
              data-category="<%= cat %>"
              role="tab"
              aria-selected="<%= selectedCategory === cat ? 'true' : 'false' %>"
            >
              <span class="filter-btn-icon" aria-hidden="true">
                <% if (cat.includes('Technical') || cat.includes('Innovation')) { %>
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
                <% } else if (cat.includes('Music') || cat.includes('Performing')) { %>
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"></path><circle cx="6" cy="18" r="3"></circle><circle cx="18" cy="16" r="3"></circle></svg>
                <% } else if (cat.includes('Dance') || cat.includes('Cultural')) { %>
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
                <% } else if (cat.includes('Social') || cat.includes('Community')) { %>
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                <% } else if (cat.includes('Literary') || cat.includes('Knowledge')) { %>
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
                <% } else if (cat.includes('Leadership') || cat.includes('Entrepreneurship')) { %>
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"></path><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"></path></svg>
                <% } else if (cat.includes('Sports') || cat.includes('Personal')) { %>
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"></path><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"></path><path d="M4 22h16"></path><path d="M10 14.66V17c0 .55-.45 1-1 1H8c-.55 0-1 .45-1 1v1h10v-1c0-.55-.45-1-1-1h-1c-.55 0-1-.45-1-1v-2.34"></path><path d="M6 4h12v5a6 6 0 0 1-12 0V4z"></path></svg>
                <% } else if (cat.includes('Environment') || cat.includes('Welfare')) { %>
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path></svg>
                <% } else { %>
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polygon points="12 6 12 12 16 14"></polygon></svg>
                <% } %>
              </span>
              <span><%= cat %></span>
            </button>
          <% }) %>
        </div>

        <button type="button" class="filter-scroll-btn filter-scroll-next" id="filterScrollNext" aria-label="Scroll filters right">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </div>
  </header>

  <!-- ========================================================
       CLUBS DIRECTORY GRID (3-Column Responsive)
       ======================================================== -->
  <section class="container clubs-directory-section">
    <div class="clubs-meta-bar">
      <span id="clubsResultsCount" class="clubs-results-count">
        Showing <strong id="visibleCount"><%= clubs.length %></strong> of <%= allClubs.length %> clubs
      </span>
      <span class="clubs-verified-tag">✓ Verified Student Organizations</span>
    </div>

    <!-- Active Grid -->
    <div id="clubsGrid" class="clubs-grid-3">
      <% clubs.forEach((club, index) => { %>
        <%
          // Serialize club data safely for modal view
          const facultyAdvisor = (club.facultyAdvisor && club.facultyAdvisor.name)
            ? club.facultyAdvisor
            : ((club.facultyAdvisors && club.facultyAdvisors[0]) || null);
          const advisorsList = facultyAdvisor ? [facultyAdvisor] : [];
          const modalData = {
            id: club._id,
            name: club.name,
            code: club.code,
            category: club.category,
            tagline: club.tagline || '',
            description: club.description || '',
            objectives: club.objectives || [],
            banner: club.banner,
            recruitmentStatus: club.recruitmentStatus || null,
            advisors: advisorsList
          };
        %>
        <article 
          class="club-dir-card" 
          data-name="<%= club.name.toLowerCase() %>" 
          data-code="<%= (club.code || '').toLowerCase() %>"
          data-category="<%= club.category %>" 
          data-desc="<%= (club.description || '').toLowerCase() %>"
          data-tagline="<%= (club.tagline || '').toLowerCase() %>"
          data-recruitment-open="<%= club.recruitmentStatus === 'Open' ? 'true' : 'false' %>"
          data-recruitment-soon="<%= (club.recruitmentStatus === 'Coming Soon' || club.recruitmentStatus === 'Recruiting Soon') ? 'true' : 'false' %>"
          data-recruitment-status="<%= (club.recruitmentStatus || '').toLowerCase() %>"
        >
          <!-- Card Image Header with Category Badge & Recruitment Badge -->
          <div class="club-dir-image-wrap">
            <img 
              src="<%= club.banner %>" 
              alt="<%= club.name %> cover" 
              class="club-dir-img" 
              loading="lazy"
              onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1517694712202-14dd9538aa97?auto=format&fit=crop&w=700&q=80';"
            >
            <span class="club-dir-cat-badge"><%= club.category %></span>
            <% if (club.recruitmentStatus === 'Open') { %>
              <span class="club-dir-recruit-badge badge-recruiting-open">Recruiting</span>
            <% } else if (club.recruitmentStatus === 'Coming Soon' || club.recruitmentStatus === 'Recruiting Soon') { %>
              <span class="club-dir-recruit-badge badge-recruiting-soon">Recruiting Soon</span>
            <% } %>
          </div>

          <!-- Card Body -->
          <div class="club-dir-body">
            <div class="club-dir-title-row">
              <h3 class="club-dir-title"><%= club.name %></h3>
              <% if (club.code) { %>
                <span class="club-dir-code"><%= club.code %></span>
              <% } %>
            </div>

            <p class="club-dir-desc">
              <%= club.description %>
            </p>

            <!-- Verified Advisor Snippet -->
            <div class="club-dir-advisor-snippet">
              <span class="advisor-label">Faculty Advisor:</span>
              <span class="advisor-name">
                <%= (advisorsList && advisorsList.length > 0) ? advisorsList[0].name : (club.facultyAdvisor ? club.facultyAdvisor.name : 'Verified Faculty Advisor') %>
              </span>
            </div>

            <!-- Card Actions -->
            <div class="club-dir-footer">
              <a 
                href="/clubs/<%= club._id %>" 
                class="btn-explore-modal" 
                title="Explore <%= club.name %> details"
              >
                <span>Explore Club</span>
                <span class="btn-arrow" aria-hidden="true">&rarr;</span>
              </a>

              <div class="club-dir-secondary-actions">
                <% if (user && user.role === 'student' && club._id) { %>
                  <form action="/clubs/<%= club._id %>/save" method="POST" style="display:inline;">
                    <button 
                      type="submit" 
                      class="btn-save-circle <%= savedClubIds.includes(club._id.toString()) ? 'saved' : '' %>" 
                      title="<%= savedClubIds.includes(club._id.toString()) ? 'Saved to dashboard' : 'Save club' %>"
                    >
                      <%= savedClubIds.includes(club._id.toString()) ? '★' : '☆' %>
                    </button>
                  </form>
                <% } %>
                <a href="/clubs/<%= club._id %>" class="btn-direct-link" title="Open full club profile page">
                  ↗
                </a>
              </div>
            </div>
          </div>
        </article>
      <% }) %>
    </div>

    <!-- Empty Results Placeholder (Hidden by default, shown when filters match 0 clubs) -->
    <div id="noClubsFound" class="clubs-empty-state" style="<%= clubs.length === 0 ? '' : 'display: none;' %>">
      <div class="empty-state-icon">🔍</div>
      <h3>No matching clubs found</h3>
      <p>We couldn't find any student clubs matching your search criteria. Try a different keyword or category.</p>
      <button type="button" id="resetFiltersBtn" class="btn-reset-filters">
        Reset All Filters
      </button>
    </div>
  </section>
</main>

<!-- ========================================================
     REUSABLE CLUB DETAILS MODAL (POPUP VIEW)
     ======================================================== -->
<div id="clubDetailsModal" class="club-modal-overlay" aria-hidden="true" role="dialog" aria-labelledby="modalClubName">
  <div class="club-modal-container">
    <button type="button" class="club-modal-close" onclick="closeClubModal()" aria-label="Close modal">✕</button>

    <!-- Modal Header Banner -->
    <div class="club-modal-banner-wrap">
      <img id="modalClubImg" src="" alt="Club banner" class="club-modal-banner-img">
      <div class="club-modal-banner-overlay">
        <span id="modalClubCategory" class="club-modal-cat-badge">Category</span>
        <h2 id="modalClubName" class="club-modal-title">Club Name</h2>
        <p id="modalClubTagline" class="club-modal-tagline"></p>
      </div>
    </div>

    <!-- Modal Content -->
    <div class="club-modal-body">
      <!-- About Section -->
      <div class="modal-section">
        <h4 class="modal-section-title">About the Club</h4>
        <p id="modalClubAbout" class="modal-section-text"></p>
      </div>

      <!-- Main Activities Section -->
      <div class="modal-section" id="modalActivitiesSection">
        <h4 class="modal-section-title">Main Activities & What You'll Do</h4>
        <ul id="modalClubActivities" class="modal-activities-list"></ul>
      </div>

      <!-- Verified Faculty Advisor Section -->
      <div class="modal-section">
        <h4 class="modal-section-title">Verified Faculty Advisor</h4>
        <div id="modalAdvisorsList" class="modal-advisors-grid"></div>
      </div>

      <!-- Recruitment Status & Actions -->
      <div class="modal-footer-row">
        <div class="modal-status-box" id="modalStatusBox">
          <span class="status-label">Recruitment Status:</span>
          <span id="modalRecruitStatus" class="status-badge status-open">Open</span>
        </div>

        <div class="modal-action-buttons">
          <a id="modalFullPageBtn" href="#" class="btn-modal-fullpage">
            <span>View Full Page</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
          <% if (user && user.role === 'student') { %>
            <form id="modalJoinForm" action="#" method="POST" style="display:inline;">
              <button type="submit" class="btn-modal-join">
                Request to Join
              </button>
            </form>
          <% } else if (!user) { %>
            <a href="/auth/login" class="btn-modal-join">
              Login to Join
            </a>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ========================================================
     CLIENT-SIDE DYNAMIC FILTER & MODAL JAVASCRIPT
     ======================================================== -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('clubSearchInput');
    const clearBtn = document.getElementById('clearSearchBtn');
    const categoryBtns = document.querySelectorAll('.category-filter-btn[data-category]');
    const recruitingFilterBtn = document.getElementById('recruitingFilterBtn');
    const recruitingSoonFilterBtn = document.getElementById('recruitingSoonFilterBtn');
    const cards = document.querySelectorAll('.club-dir-card');
    const emptyState = document.getElementById('noClubsFound');
    const visibleCountSpan = document.getElementById('visibleCount');
    const resetBtn = document.getElementById('resetFiltersBtn');

    let activeCategory = '<%= selectedCategory || "All Clubs" %>';
    let searchQuery = (searchInput.value || '').trim().toLowerCase();
    let activeRecruitmentOnly = false;
    let activeRecruitingSoonOnly = false;

    function filterClubs() {
      let visible = 0;
      const q = searchQuery.toLowerCase().trim();

      cards.forEach(card => {
        const name = card.dataset.name || '';
        const code = card.dataset.code || '';
        const category = card.dataset.category || '';
        const desc = card.dataset.desc || '';
        const tagline = card.dataset.tagline || '';
        const recStatus = card.dataset.recruitmentStatus || '';

        // Category match
        const matchesCategory = (activeCategory === 'All Clubs' || activeCategory === 'All') 
          || (category.toLowerCase() === activeCategory.toLowerCase());

        // Search match
        const matchesSearch = !q 
          || name.includes(q) 
          || code.includes(q) 
          || category.toLowerCase().includes(q) 
          || desc.includes(q) 
          || tagline.includes(q)
          || recStatus.includes(q);

        const matchesRecruitment = (!activeRecruitmentOnly || card.dataset.recruitmentOpen === 'true')
          && (!activeRecruitingSoonOnly || card.dataset.recruitmentSoon === 'true');

        if (matchesCategory && matchesSearch && matchesRecruitment) {
          card.style.display = '';
          visible++;
        } else {
          card.style.display = 'none';
        }
      });

      if (visibleCountSpan) visibleCountSpan.textContent = visible;

      if (visible === 0) {
        if (emptyState) emptyState.style.display = 'block';
      } else {
        if (emptyState) emptyState.style.display = 'none';
      }

      if (clearBtn) {
        clearBtn.style.display = searchInput.value.length > 0 ? 'inline-flex' : 'none';
      }
    }

    // Live search input
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = e.target.value;
        filterClubs();
      });
    }

    // Clear search button
    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        searchInput.value = '';
        searchQuery = '';
        searchInput.focus();
        filterClubs();
      });
    }

    // Category button clicks
    categoryBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        categoryBtns.forEach(b => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');
        activeCategory = btn.dataset.category;
        btn.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        filterClubs();
      });
    });

    if (recruitingFilterBtn) {
      recruitingFilterBtn.addEventListener('click', () => {
        activeRecruitmentOnly = !activeRecruitmentOnly;
        recruitingFilterBtn.classList.toggle('active', activeRecruitmentOnly);
        recruitingFilterBtn.setAttribute('aria-pressed', String(activeRecruitmentOnly));
        if (activeRecruitmentOnly && activeRecruitingSoonOnly) {
          activeRecruitingSoonOnly = false;
          if (recruitingSoonFilterBtn) {
            recruitingSoonFilterBtn.classList.remove('active');
            recruitingSoonFilterBtn.setAttribute('aria-pressed', 'false');
          }
        }
        recruitingFilterBtn.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        filterClubs();
      });
    }

    if (recruitingSoonFilterBtn) {
      recruitingSoonFilterBtn.addEventListener('click', () => {
        activeRecruitingSoonOnly = !activeRecruitingSoonOnly;
        recruitingSoonFilterBtn.classList.toggle('active', activeRecruitingSoonOnly);
        recruitingSoonFilterBtn.setAttribute('aria-pressed', String(activeRecruitingSoonOnly));
        if (activeRecruitingSoonOnly && activeRecruitmentOnly) {
          activeRecruitmentOnly = false;
          if (recruitingFilterBtn) {
            recruitingFilterBtn.classList.remove('active');
            recruitingFilterBtn.setAttribute('aria-pressed', 'false');
          }
        }
        recruitingSoonFilterBtn.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        filterClubs();
      });
    }

    // Filter carousel scroll handling & arrows
    const filterTrack = document.getElementById('clubsFilterTrack');
    const filterWrapper = document.getElementById('filterCarouselWrapper');
    const filterScrollPrev = document.getElementById('filterScrollPrev');
    const filterScrollNext = document.getElementById('filterScrollNext');

    function updateFilterScrollUI() {
      if (!filterTrack || !filterWrapper) return;
      const scrollLeft = filterTrack.scrollLeft;
      const maxScroll = filterTrack.scrollWidth - filterTrack.clientWidth;
      const isScrollable = maxScroll > 4;

      if (!isScrollable) {
        if (filterScrollPrev) filterScrollPrev.style.display = 'none';
        if (filterScrollNext) filterScrollNext.style.display = 'none';
        filterWrapper.classList.remove('has-scroll-left', 'has-scroll-right');
        return;
      }

      if (filterScrollPrev) {
        filterScrollPrev.style.display = scrollLeft > 8 ? 'inline-flex' : 'none';
      }
      if (filterScrollNext) {
        filterScrollNext.style.display = scrollLeft < maxScroll - 8 ? 'inline-flex' : 'none';
      }

      filterWrapper.classList.toggle('has-scroll-left', scrollLeft > 8);
      filterWrapper.classList.toggle('has-scroll-right', scrollLeft < maxScroll - 8);
    }

    if (filterTrack) {
      filterTrack.addEventListener('scroll', updateFilterScrollUI, { passive: true });
      window.addEventListener('resize', updateFilterScrollUI);

      // Mouse wheel horizontal scrolling over track
      filterTrack.addEventListener('wheel', (e) => {
        if (Math.abs(e.deltaY) > Math.abs(e.deltaX) && filterTrack.scrollWidth > filterTrack.clientWidth) {
          e.preventDefault();
          filterTrack.scrollLeft += e.deltaY;
        }
      }, { passive: false });

      if (filterScrollPrev) {
        filterScrollPrev.addEventListener('click', () => {
          filterTrack.scrollBy({ left: -260, behavior: 'smooth' });
        });
      }

      if (filterScrollNext) {
        filterScrollNext.addEventListener('click', () => {
          filterTrack.scrollBy({ left: 260, behavior: 'smooth' });
        });
      }

      setTimeout(updateFilterScrollUI, 60);
    }

    // Reset filters
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        searchQuery = '';
        activeRecruitmentOnly = false;
        activeRecruitingSoonOnly = false;
        if (recruitingFilterBtn) {
          recruitingFilterBtn.classList.remove('active');
          recruitingFilterBtn.setAttribute('aria-pressed', 'false');
        }
        if (recruitingSoonFilterBtn) {
          recruitingSoonFilterBtn.classList.remove('active');
          recruitingSoonFilterBtn.setAttribute('aria-pressed', 'false');
        }
        activeCategory = 'All Clubs';
        categoryBtns.forEach(b => {
          b.classList.toggle('active', b.dataset.category === 'All Clubs');
          b.setAttribute('aria-selected', b.dataset.category === 'All Clubs' ? 'true' : 'false');
        });
        if (filterTrack) {
          filterTrack.scrollTo({ left: 0, behavior: 'smooth' });
        }
        filterClubs();
      });
    }

    // Initial filter run
    filterClubs();
  });

  // Reusable Modal Functions
  window.openClubModal = function(btn) {
    try {
      const data = JSON.parse(btn.getAttribute('data-club'));
      const modal = document.getElementById('clubDetailsModal');
      if (!modal || !data) return;

      document.getElementById('modalClubName').textContent = data.name;
      document.getElementById('modalClubCategory').textContent = data.category;
      document.getElementById('modalClubTagline').textContent = data.tagline || '';
      document.getElementById('modalClubAbout').textContent = data.description || '';
      document.getElementById('modalClubImg').src = data.banner || 'https://images.unsplash.com/photo-1517694712202-14dd9538aa97?auto=format&fit=crop&w=700&q=80';

      // Activities
      const actList = document.getElementById('modalClubActivities');
      actList.innerHTML = '';
      if (data.objectives && data.objectives.length > 0) {
        data.objectives.forEach(act => {
          const li = document.createElement('li');
          li.textContent = act;
          actList.appendChild(li);
        });
        document.getElementById('modalActivitiesSection').style.display = 'block';
      } else {
        document.getElementById('modalActivitiesSection').style.display = 'none';
      }

      // Verified Faculty Advisor
      const advGrid = document.getElementById('modalAdvisorsList');
      advGrid.innerHTML = '';
      if (data.advisors && data.advisors.length > 0) {
        data.advisors.forEach(adv => {
          const item = document.createElement('div');
          item.className = 'advisor-pill-card';
          item.innerHTML = `
            <div class="adv-icon">👨‍🏫</div>
            <div class="adv-text">
              <strong>${adv.name}</strong>
              <small>${adv.department ? 'Dept. of ' + adv.department : 'Faculty Advisor'}</small>
            </div>
          `;
          advGrid.appendChild(item);
        });
      } else {
        advGrid.innerHTML = '<span style="color:#64748b; font-size:0.85rem;">Official faculty guidance verified by college affairs.</span>';
      }

      // Recruitment Status
      const statusBox = document.getElementById('modalStatusBox');
      const statusBadge = document.getElementById('modalRecruitStatus');
      if (data.recruitmentStatus === 'Open') {
        if (statusBox) statusBox.style.display = 'flex';
        statusBadge.textContent = 'Recruiting';
        statusBadge.className = 'status-badge status-open';
      } else if (data.recruitmentStatus === 'Coming Soon' || data.recruitmentStatus === 'Recruiting Soon') {
        if (statusBox) statusBox.style.display = 'flex';
        statusBadge.textContent = 'Recruiting Soon';
        statusBadge.className = 'status-badge status-soon';
      } else if (data.recruitmentStatus === 'Closed') {
        if (statusBox) statusBox.style.display = 'flex';
        statusBadge.textContent = 'Closed';
        statusBadge.className = 'status-badge status-closed';
      } else {
        if (statusBox) statusBox.style.display = 'none';
      }

      // Actions
      const fullPageBtn = document.getElementById('modalFullPageBtn');
      if (fullPageBtn) fullPageBtn.href = '/clubs/' + (data.id || data.code.toLowerCase());

      const joinForm = document.getElementById('modalJoinForm');
      if (joinForm) joinForm.action = '/clubs/' + (data.id || data.code.toLowerCase()) + '/join';

      modal.classList.add('active');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    } catch (e) {
      console.error('Error opening club modal:', e);
    }
  };

  window.closeClubModal = function() {
    const modal = document.getElementById('clubDetailsModal');
    if (modal) {
      modal.classList.remove('active');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }
  };

  // Close modal on escape or backdrop click
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeClubModal();
  });

  const modalOverlay = document.getElementById('clubDetailsModal');
  if (modalOverlay) {
    modalOverlay.addEventListener('click', (e) => {
      if (e.target === modalOverlay) closeClubModal();
    });
  }
</script>

