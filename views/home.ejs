<%- include('partials/header') %>
<%- include('partials/navbar') %>
<%- include('partials/alerts') %>

<main class="home-page">
  <section class="home-hero">
    <div class="container home-hero-grid">
      <div class="home-hero-copy">
        <span class="home-eyebrow"><span class="home-eyebrow-dot"></span> College of Technology · Student community</span>
        <h1>Find your people.<br><span>Make things happen.</span></h1>
        <p>Discover the clubs, people, and opportunities that make campus life yours. Explore communities, join a team, and find your next event—all in one place.</p>
        <div class="home-hero-actions">
          <a href="/clubs" class="btn btn-primary btn-lg">Explore clubs <span aria-hidden="true">↗</span></a>
          <a href="/events" class="home-text-link">See what's happening <span aria-hidden="true">→</span></a>
        </div>
        <div class="home-hero-note">
          <span class="home-note-avatars" aria-hidden="true"><i>C</i><i>R</i><i>A</i></span>
          <span>A campus full of ways to get involved</span>
        </div>
      </div>

      <div class="home-hero-art" aria-label="A preview of campus clubs and events">
        <div class="home-art-orbit home-art-orbit-one"></div>
        <div class="home-art-orbit home-art-orbit-two"></div>
        <div class="home-art-spark home-art-spark-one">✳</div>
        <div class="home-art-spark home-art-spark-two">✦</div>
        <div class="home-art-tile home-art-tile-back">
          <span class="home-art-tile-icon">✳</span>
          <span>Find your community</span>
        </div>
        <div class="home-art-main-card">
          <div class="home-art-card-top">
            <span class="home-art-mark">CS</span>
            <span class="home-art-status"><i></i> Your next chapter</span>
          </div>
          <% if (featuredClubs && featuredClubs.length > 0) { %>
            <div class="home-art-club-icon"><%= featuredClubs[0].name.substring(0, 1) %></div>
            <span class="home-art-kicker"><%= featuredClubs[0].category %> COMMUNITY</span>
            <h2><%= featuredClubs[0].name %></h2>
            <p><%= featuredClubs[0].tagline %></p>
            <a href="/clubs/<%= featuredClubs[0]._id %>" class="home-art-card-link">Get to know the club <span aria-hidden="true">↗</span></a>
          <% } else { %>
            <div class="home-art-club-icon">✦</div>
            <span class="home-art-kicker">CAMPUS COMMUNITY</span>
            <h2>Your people are here.</h2>
            <p>Explore new interests, meet collaborators, and make campus yours.</p>
            <a href="/clubs" class="home-art-card-link">Find your community <span aria-hidden="true">↗</span></a>
          <% } %>
        </div>
        <div class="home-art-floating">
          <span class="home-floating-icon">↗</span>
          <span><strong><%= stats.openRecruitmentsCount %> opportunities</strong><small>open to explore</small></span>
        </div>
        <div class="home-art-caption">A little curiosity goes a long way.</div>
      </div>
    </div>
  </section>

  <section class="home-proof">
    <div class="container home-proof-inner">
      <span class="home-proof-label">A campus that comes together</span>
      <div class="home-proof-stats">
        <div><strong><%= stats.clubsCount %></strong><span>communities</span></div>
        <i></i>
        <div><strong><%= stats.openRecruitmentsCount %></strong><span>open opportunities</span></div>
        <i></i>
        <div><strong><%= stats.eventsCount %></strong><span>upcoming events</span></div>
      </div>
      <a href="/clubs" class="home-proof-link">Find your starting point <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="home-intro home-section">
    <div class="container home-intro-grid">
      <div>
        <span class="home-section-index">01 / A CAMPUS, CONNECTED</span>
        <h2>More than a list of clubs.<br><span>A place to belong.</span></h2>
      </div>
      <div class="home-intro-copy">
        <p>Finding your community shouldn't mean chasing links across group chats. ClubSphere brings campus activities together, so you can spend less time searching and more time doing.</p>
        <a href="/clubs" class="home-underlined-link">A better way to get involved <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="container home-benefits">
      <article>
        <span class="home-benefit-number">01</span>
        <div><h3>Discover with purpose</h3><p>Find communities by interest, browse what they do, and meet the people behind them.</p></div>
      </article>
      <article>
        <span class="home-benefit-number">02</span>
        <div><h3>Take your next step</h3><p>Request to join a club or apply for an open role, with every update in one place.</p></div>
      </article>
      <article>
        <span class="home-benefit-number">03</span>
        <div><h3>Show up for more</h3><p>Keep up with campus events and register for the experiences that interest you.</p></div>
      </article>
    </div>
  </section>

  <section class="home-communities home-section">
    <div class="container">
      <div class="home-section-heading">
        <div>
          <span class="home-section-index">02 / FIND YOUR INTEREST</span>
          <h2>There’s a place for <span>your kind of curious.</span></h2>
        </div>
        <a href="/clubs" class="home-underlined-link">Explore every club <span aria-hidden="true">↗</span></a>
      </div>

      <div class="home-category-grid">
        <a class="home-category-card home-category-tech" href="/clubs?category=Technical">
          <span class="home-category-symbol" aria-hidden="true">⌘</span>
          <span class="home-category-number">01</span>
          <div><span>Build what’s next</span><h3>Technology</h3><span class="home-category-arrow" aria-hidden="true">↗</span></div>
        </a>
        <a class="home-category-card home-category-culture" href="/clubs?category=Cultural">
          <span class="home-category-symbol" aria-hidden="true">✳</span>
          <span class="home-category-number">02</span>
          <div><span>Make room for expression</span><h3>Culture & arts</h3><span class="home-category-arrow" aria-hidden="true">↗</span></div>
        </a>
        <a class="home-category-card home-category-sport" href="/clubs?category=Sports">
          <span class="home-category-symbol" aria-hidden="true">↗</span>
          <span class="home-category-number">03</span>
          <div><span>Find your team</span><h3>Sports & wellness</h3><span class="home-category-arrow" aria-hidden="true">↗</span></div>
        </a>
        <a class="home-category-card home-category-social" href="/clubs?category=Social%20%26%20NSS">
          <span class="home-category-symbol" aria-hidden="true">♡</span>
          <span class="home-category-number">04</span>
          <div><span>Make a difference</span><h3>People & impact</h3><span class="home-category-arrow" aria-hidden="true">↗</span></div>
        </a>
      </div>
    </div>
  </section>

  <% if (activeRecruitments && activeRecruitments.length > 0) { %>
    <section class="home-opportunities home-section">
      <div class="container home-opportunities-grid">
        <div class="home-opportunities-intro">
          <span class="home-section-index">03 / YOUR NEXT MOVE</span>
          <h2>Good things happen when you <span>put yourself out there.</span></h2>
          <p>Clubs are looking for new ideas and new teammates. Find an open role that feels like you.</p>
          <a href="/clubs" class="btn btn-light">See all opportunities <span aria-hidden="true">↗</span></a>
          <div class="home-opportunity-count"><strong><%= stats.openRecruitmentsCount %></strong><span>open drives across campus</span></div>
        </div>
        <div class="home-opportunity-list">
          <% activeRecruitments.slice(0, 3).forEach((rec, index) => { %>
            <article class="home-opportunity-item">
              <span class="home-opportunity-index">0<%= index + 1 %></span>
              <div class="home-opportunity-copy">
                <span><%= rec.club ? rec.club.name : 'Campus club' %> · <%= rec.club ? rec.club.category : 'Community' %></span>
                <h3><%= rec.title %></h3>
                <small><%= rec.roles.length %> open <%= rec.roles.length === 1 ? 'role' : 'roles' %> <span aria-hidden="true">·</span> Apply by <%= new Date(rec.deadline).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %></small>
              </div>
              <% if (user && user.role === 'student') { %>
                <a href="/student/recruitments/<%= rec._id %>/apply" aria-label="Apply for <%= rec.title %>">↗</a>
              <% } else { %>
                <a href="<%= rec.club ? '/clubs/' + rec.club._id : '/clubs' %>" aria-label="View <%= rec.title %>">↗</a>
              <% } %>
            </article>
          <% }) %>
        </div>
      </div>
    </section>
  <% } %>

  <% if (featuredClubs && featuredClubs.length > 0) { %>
    <section class="home-clubs home-section">
      <div class="container">
        <div class="home-section-heading">
          <div>
            <span class="home-section-index">04 / PEOPLE TO MEET</span>
            <h2>Meet the communities <span>making campus.</span></h2>
          </div>
          <a href="/clubs" class="home-underlined-link">All clubs <span aria-hidden="true">↗</span></a>
        </div>
        <div class="home-club-grid">
          <% featuredClubs.slice(0, 3).forEach((club, index) => { %>
            <a href="/clubs/<%= club._id %>" class="home-club-card">
              <div class="home-club-art home-club-art-<%= index + 1 %>">
                <span><%= club.name.substring(0, 1) %></span>
                <small><%= club.code %></small>
              </div>
              <div class="home-club-details">
                <span class="home-club-category"><%= club.category %></span>
                <h3><%= club.name %></h3>
                <p><%= club.tagline %></p>
                <span class="home-club-link">Discover the club <span aria-hidden="true">↗</span></span>
              </div>
            </a>
          <% }) %>
        </div>
      </div>
    </section>
  <% } %>

  <% if (upcomingEvents && upcomingEvents.length > 0) { %>
    <section class="home-events home-section">
      <div class="container home-events-grid">
        <div class="home-events-intro">
          <span class="home-section-index">05 / ON THE CALENDAR</span>
          <h2>Make a little room for <span>something new.</span></h2>
          <p>From hands-on workshops to campus-wide celebrations, there’s always something worth showing up for.</p>
          <a href="/events" class="home-underlined-link">See all campus events <span aria-hidden="true">↗</span></a>
        </div>
        <div class="home-event-list">
          <% upcomingEvents.slice(0, 3).forEach(evt => { %>
            <a href="/events/<%= evt._id %>" class="home-event-item">
              <div class="home-event-date">
                <strong><%= new Date(evt.eventDate).toLocaleDateString('en-IN', { day: '2-digit' }) %></strong>
                <span><%= new Date(evt.eventDate).toLocaleDateString('en-IN', { month: 'short' }) %></span>
              </div>
              <div>
                <span><%= evt.club ? evt.club.name : 'Campus event' %></span>
                <h3><%= evt.title %></h3>
                <small><%= evt.venue %> <span aria-hidden="true">·</span> <%= evt.startTime %></small>
              </div>
              <span class="home-event-arrow" aria-hidden="true">↗</span>
            </a>
          <% }) %>
        </div>
      </div>
    </section>
  <% } %>

  <section class="home-cta">
    <div class="container home-cta-inner">
      <span class="home-section-index">YOUR CAMPUS. YOUR PEOPLE.</span>
      <h2>It all starts with <span>showing up.</span></h2>
      <p>Explore what’s happening at College of Technology and find your place in it.</p>
      <div class="home-hero-actions">
        <a href="/clubs" class="btn btn-light btn-lg">Find your community <span aria-hidden="true">↗</span></a>
        <% if (!user) { %>
          <a href="/auth/register" class="home-cta-link">Create your student account <span aria-hidden="true">→</span></a>
        <% } %>
      </div>
    </div>
  </section>

  <section class="container demo-switcher">
    <button
      type="button"
      class="demo-access-toggle"
      id="homeDemoAccessToggle"
      aria-expanded="false"
      aria-controls="homeDemoPanel"
    >Demo access</button>
    <div id="homeDemoPanel" hidden>
      <div class="viva-banner">
        <div class="viva-banner-title"><span>🎓</span><span>Viva Examiner & Demo Switcher (Instant Test Accounts)</span></div>
        <p style="font-size: 0.85rem; color: #64748b; margin-bottom: 0.75rem;">
          Use these pre-seeded credentials to demonstrate any of the 5 user roles. The common password is <code>password123</code>.
        </p>
        <div class="viva-roles-grid">
          <div class="viva-role-card"><div><strong>🎓 Student</strong><div><code>student@college.ac.in</code></div></div><a href="/auth/login?role=student" class="btn btn-sm btn-outline" style="margin-top: 8px;">Login as Student</a></div>
          <div class="viva-role-card"><div><strong>⚡ Club Secretary</strong><div><code>secretary@college.ac.in</code></div></div><a href="/auth/login?role=secretary" class="btn btn-sm btn-outline" style="margin-top: 8px;">Login as Secretary</a></div>
          <div class="viva-role-card"><div><strong>🛡️ Core Member</strong><div><code>core@college.ac.in</code></div></div><a href="/auth/login?role=core" class="btn btn-sm btn-outline" style="margin-top: 8px;">Login as Core</a></div>
          <div class="viva-role-card"><div><strong>👨‍🏫 Faculty Advisor</strong><div><code>faculty@college.ac.in</code></div></div><a href="/auth/login?role=faculty" class="btn btn-sm btn-outline" style="margin-top: 8px;">Login as Faculty</a></div>
          <div class="viva-role-card"><div><strong>👑 Admin (Dean)</strong><div><code>admin@college.ac.in</code></div></div><a href="/auth/login?role=admin" class="btn btn-sm btn-outline" style="margin-top: 8px;">Login as Admin</a></div>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
