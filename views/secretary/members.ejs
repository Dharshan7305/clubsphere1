<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<main class="container" style="padding-top: 2rem; padding-bottom: 4rem;">
  <div class="section-header">
    <div>
      <h1 class="section-title">Club Members &amp; Requests</h1>
      <p class="section-subtitle">
        Manage members and review join requests for <strong><%= club.name %></strong>. Approved members: <%= club.members.length %> / <%= club.teamLimit %>. Roster entries: <%= members.length %>.
      </p>
    </div>
    <div style="display: flex; gap: 0.5rem;">
      <a href="/secretary/club" class="btn btn-outline">Manage Member Limit</a>
      <a href="/secretary/dashboard" class="btn btn-outline">Back to Dashboard</a>
    </div>
  </div>

  <section class="card" style="margin-bottom: 2rem;">
    <div class="card-header">
      <h2 style="font-size: 1.05rem; font-weight: 700; color: var(--primary);">Current Club Members</h2>
      <span class="badge badge-category"><%= members.length %></span>
    </div>
    <% if (members.length === 0) { %>
      <div class="card-body" style="text-align: center; padding: 2rem 1rem;">
        <p style="color: var(--text-muted);">Approved normal members and core members assigned to this club will appear here.</p>
      </div>
    <% } else { %>
      <div class="table-responsive" style="border: none; box-shadow: none;">
        <table class="table">
          <thead>
            <tr>
              <th>Member</th>
              <th>Department &amp; Year</th>
              <th>Club Role</th>
              <th>Update Role</th>
            </tr>
          </thead>
          <tbody>
            <% members.forEach(member => { %>
              <% const isCoreMember = coreMemberIds.includes(member._id.toString()); %>
              <tr>
                <td>
                  <strong><%= member.name %></strong>
                  <div style="font-size: 0.8rem; color: var(--text-muted);"><%= member.rollNo || 'No roll number' %> · <%= member.email %></div>
                </td>
                <td><%= member.department || '—' %> · Year <%= member.year || '—' %></td>
                <td>
                  <span class="badge <%= isCoreMember ? 'badge-category' : 'badge-submitted' %>">
                    <%= isCoreMember ? 'Core Member' : 'Normal Member' %>
                  </span>
                </td>
                <td>
                  <% if (['student', 'core'].includes(member.role)) { %>
                    <form action="/secretary/members/<%= member._id %>/role" method="POST" style="display: flex; align-items: center; gap: 0.5rem;">
                      <% if (user.role === 'admin') { %>
                        <input type="hidden" name="clubId" value="<%= club._id %>">
                      <% } %>
                      <select name="role" class="form-control" aria-label="Role for <%= member.name %>" required>
                        <option value="member" <%= isCoreMember ? '' : 'selected' %>>Normal Member</option>
                        <option value="core" <%= isCoreMember ? 'selected' : '' %>>Core Member</option>
                      </select>
                      <button type="submit" class="btn btn-sm btn-primary">Save</button>
                    </form>
                  <% } else { %>
                    <span style="font-size: 0.8rem; color: var(--text-muted);">Role managed by college</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>

  <div class="section-header" style="margin-bottom: 1rem;">
    <h2 class="section-title" style="font-size: 1.35rem;">Join Requests</h2>
  </div>

  <% if (membershipRequests.length === 0) { %>
    <div class="card">
      <div class="card-body" style="text-align: center; padding: 3rem 1rem;">
        <h3 style="color: var(--primary); margin-bottom: 0.5rem;">No membership requests yet</h3>
        <p style="color: var(--text-muted);">Student requests to join your club will appear here.</p>
      </div>
    </div>
  <% } else { %>
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th>Student</th>
            <th>Department & Year</th>
            <th>Request Note</th>
            <th>Requested</th>
            <th>Status / Decision</th>
          </tr>
        </thead>
        <tbody>
          <% membershipRequests.forEach(request => { %>
            <tr>
              <td>
                <strong><%= request.student ? request.student.name : 'Student account unavailable' %></strong>
                <% if (request.student) { %>
                  <div style="font-size: 0.8rem; color: var(--text-muted);"><%= request.student.rollNo %> · <%= request.student.email %></div>
                <% } %>
              </td>
              <td>
                <% if (request.student) { %>
                  <%= request.student.department %> · Year <%= request.student.year %>
                <% } else { %>
                  —
                <% } %>
              </td>
              <td style="max-width: 300px; white-space: normal;"><%= request.message || 'No note provided' %></td>
              <td><%= new Date(request.createdAt).toLocaleDateString() %></td>
              <td>
                <% if (request.status === 'Pending') { %>
                  <div style="display: flex; gap: 0.4rem;">
                    <form action="/secretary/members/<%= request._id %>/status" method="POST">
                      <% if (user.role === 'admin') { %>
                        <input type="hidden" name="clubId" value="<%= club._id %>">
                      <% } %>
                      <input type="hidden" name="status" value="Approved">
                      <button type="submit" class="btn btn-sm btn-primary" <%= club.members.length >= club.teamLimit && (!request.student || !club.members.some(id => id.toString() === request.student._id.toString())) ? 'disabled title="Member limit reached"' : '' %>>Approve</button>
                    </form>
                    <form action="/secretary/members/<%= request._id %>/status" method="POST">
                      <% if (user.role === 'admin') { %>
                        <input type="hidden" name="clubId" value="<%= club._id %>">
                      <% } %>
                      <input type="hidden" name="status" value="Rejected">
                      <button type="submit" class="btn btn-sm btn-outline">Reject</button>
                    </form>
                  </div>
                <% } else { %>
                  <span class="badge <%= request.status === 'Approved' ? 'badge-accepted' : 'badge-rejected' %>"><%= request.status %></span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</main>

<%- include('../partials/footer') %>
